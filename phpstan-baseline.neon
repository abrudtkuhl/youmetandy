parameters:
	ignoreErrors:
		-
			message: '#^Method App\\Console\\Commands\\UpdateSiteContent\:\:handle\(\) has no return type specified\.$#'
			identifier: missingType.return
			count: 1
			path: app/Console/Commands/UpdateSiteContent.php

		-
			message: '#^Parameter \#1 \$json of function json_decode expects string, string\|false given\.$#'
			identifier: argument.type
			count: 1
			path: app/Console/Commands/UpdateSiteContent.php

		-
			message: '#^Expression on left side of \?\? is not nullable\.$#'
			identifier: nullCoalesce.expr
			count: 2
			path: app/Helpers/RssFeedParser.php

		-
			message: '#^Method App\\Helpers\\RssFeedParser\:\:extractDescription\(\) has no return type specified\.$#'
			identifier: missingType.return
